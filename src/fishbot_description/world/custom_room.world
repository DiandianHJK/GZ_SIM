          <geometry>
            <box>
              <size>10 8 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.92 0.85 0.7 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
      <!-- 北墙 -->
