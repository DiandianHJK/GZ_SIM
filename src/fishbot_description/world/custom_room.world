<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="room_world">
    <!-- 全局光照：关闭高光、关闭阴影，消除反光 -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.2 0.2 -0.8</direction>
    </light>

    <!-- 卧室房间：地面 + 四周墙 -->
    <model name="bedroom">
      <static>true</static>
      <!-- 卧室地面：中心下移到z=-0.1，顶面=-0.05，轮子z=0不穿地 -->
      <link name="floor">
        <pose>0 0 -0.1 0 0 0</pose>
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>10 8 0.1</size>
            </box>
          </geometry>
        </collision>
