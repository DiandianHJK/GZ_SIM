<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_control_plugin">
        <gazebo>
            <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
                <!-- 车轮关节，和你原来保持一致 -->
                <left_joint>left_wheel_joint</left_joint>
                <right_joint>right_wheel_joint</right_joint>

                <!-- 运动学参数：原来 wheel_diameter=0.064 → radius=0.032 -->
                <wheel_separation>0.2</wheel_separation>
                <wheel_radius>0.032</wheel_radius>

                <!-- 话题配置 -->
                <topic>cmd_vel</topic>              <!-- 订阅Twist指令 -->
                <odom_topic>odom</odom_topic>       <!-- 发布odom -->

                <!-- 坐标系，和之前保持一致 -->
                <frame_id>odom</frame_id>
                <child_frame_id>base_footprint</child_frame_id>

                <!-- 发布频率，等价原来 update_rate=30 -->
                <odom_publisher_frequency>30</odom_publisher_frequency>

                <!-- 动力学限速（整车） -->
                <max_linear_velocity>2.0</max_linear_velocity>
                <max_angular_velocity>2.0</max_angular_velocity>
                <max_linear_acceleration>1.0</max_linear_acceleration>
                <max_angular_acceleration>1.0</max_angular_acceleration>

                <!-- 是否发布odom TF（odom → base_footprint） -->
                <tf_topic>/tf</tf_topic> 
            </plugin>
            <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
                <joint_name>left_wheel_joint</joint_name>
                <joint_name>right_wheel_joint</joint_name>
                <update_frequency>30</update_frequency>
                <topic>joint_states</topic>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>